  <!-- ========== Site JS: Motion, Scrollspy, Project Controls ========== -->
  <script>
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- Scroll-Reveal ----
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const els = document.querySelectorAll('[data-animate="fade-up"]');
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = parseInt(el.getAttribute('data-animate-delay') || '0', 10);
              setTimeout(() => {
                el.classList.remove('opacity-0', 'translate-y-3');
                el.classList.add('opacity-100', 'translate-y-0');
              }, delay);
              obs.unobserve(el);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });

        els.forEach((el) => {
          // keep JIT classes for CDN; safe to remove if using a built Tailwind CSS
          el.classList.add('opacity-0', 'translate-y-3');
          el.classList.add('opacity-100', 'translate-y-0'); // keep JIT classes
          el.classList.remove('opacity-100', 'translate-y-0');
          io.observe(el);
        });
      } else {
        document.querySelectorAll('[data-animate="fade-up"]').forEach((el) => {
          el.classList.remove('opacity-0', 'translate-y-3');
          el.classList.add('opacity-100', 'translate-y-0');
        });
      }

      // ---- Scrollspy (5): robust activation + fallback when none intersect ----
      const sections = ['about', 'projects', 'blog', 'contact'];
      const navMap = new Map(sections.map(id => [id, document.querySelector(`[data-nav="${id}"]`)]));
      const ratioMap = new Map();
      function setActive(id) {
        document.querySelectorAll('[data-nav]').forEach(a => {
          a.classList.remove('nav-active');
          a.removeAttribute('aria-current');
        });
        const link = navMap.get(id);
        if (link) { link.classList.add('nav-active'); link.setAttribute('aria-current','page'); }
      }
      function closestByViewport() {
        const center = window.innerHeight * 0.33;
        let best = { id:null, dist: Infinity };
        sections.forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          const r = el.getBoundingClientRect();
          const dist = Math.abs(r.top - center);
          if (dist < best.dist) best = { id, dist };
        });
        return best.id;
      }

      if ('IntersectionObserver' in window) {
        const spIo = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            ratioMap.set(entry.target.id, entry.intersectionRatio);
          });
          // pick the section with highest ratio > 0
          let bestId = null, bestRatio = 0;
          ratioMap.forEach((ratio, id) => {
            if (ratio > bestRatio) { bestRatio = ratio; bestId = id; }
          });
          if (bestRatio > 0) {
            setActive(bestId);
          } else {
            // Fallback: none intersecting -> choose closest to viewport top
            const id = closestByViewport();
            if (id) setActive(id);
          }
        }, { rootMargin: '-40% 0px -50% 0px', threshold: [0.01, 0.25, 0.5, 0.75, 1] });

        sections.forEach(id => {
          const el = document.getElementById(id);
          if (el) spIo.observe(el);
        });

        // Ensure one active on load and after hash changes
        window.addEventListener('DOMContentLoaded', () => {
          const hash = (location.hash || '').replace('#','');
          setActive(sections.includes(hash) ? hash : closestByViewport() || sections[0]);
        });
        window.addEventListener('hashchange', () => {
          const hash = (location.hash || '').replace('#','');
          if (sections.includes(hash)) setActive(hash);
        });
        // Also update on scroll as a safety net if IO misses
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            let bestId = null, bestRatio = 0;
            ratioMap.forEach((ratio, id) => { if (ratio > bestRatio) { bestRatio = ratio; bestId = id; } });
            if (bestRatio === 0) {
              const id = closestByViewport();
              if (id) setActive(id);
            }
            ticking = false;
          });
        }, { passive: true });
      } else {
        // No IO support: simple scroll fallback
        const onScroll = () => setActive(closestByViewport() || sections[0]);
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('DOMContentLoaded', onScroll);
      }

      // ---- Subtle "magnetic" hover for cards & primary CTAs ----
      if (!reduceMotion) {
        const hoverables = document.querySelectorAll('article.project-card, a.inline-flex');
        hoverables.forEach((el) => {
          el.classList.add('magnet');
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
            const y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
            el.style.setProperty('--tx', `${x * 2}px`);
            el.style.setProperty('--ty', `${y * 2}px`);
          });
          el.addEventListener('mouseleave', () => {
            el.style.removeProperty('--tx');
            el.style.removeProperty('--ty');
          });
        });
      }

      // ---- Project Controls: filter chips, search, sort (5: robust date handling) ----
      const grid = document.getElementById('proj-grid');
      const cards = Array.from(grid.querySelectorAll('.project-card'));
      const chips = Array.from(document.querySelectorAll('.chip[data-chip]'));
      const search = document.getElementById('proj-search');
      const sortSel = document.getElementById('proj-sort');

      // Normalize & precompute timestamps once to avoid cross-browser Date quirks
      cards.forEach(c => {
        const iso = (c.dataset.updated || '').trim();
        const ts = Date.parse(iso); // ISO 8601 -> ms since epoch
        if (!Number.isNaN(ts)) c.dataset.updatedTs = String(ts);
      });

      const active = new Set(['all']);
      function normalize(s) { return (s || '').toLowerCase().trim(); }

      function matchesTags(card) {
        if (active.has('all')) return true;
        const tags = (card.dataset.tags || '').split(/\s+/);
        for (const t of active) { if (!tags.includes(t)) return false; }
        return true;
      }
      function matchesSearch(card) {
        const q = normalize(search.value);
        if (!q) return true;
        const title = normalize(card.dataset.title);
        return title.includes(q);
      }
      function sortCards(list) {
        const mode = sortSel.value;
        const byTitle = (a,b)=> a.dataset.title.localeCompare(b.dataset.title);
        const ts = (el)=> Number(el.dataset.updatedTs || 0);
        const byRecent = (a,b)=> ts(b) - ts(a);
        const byFeatured = (a,b)=> (+b.dataset.featured - +a.dataset.featured) || byRecent(a,b);
        if (mode === 'alpha') return list.sort(byTitle);
        if (mode === 'recent') return list.sort(byRecent);
        return list.sort(byFeatured);
      }
      function render() {
        const visible = cards.filter(c => matchesTags(c) && matchesSearch(c));
        const hidden = cards.filter(c => !visible.includes(c));
        sortCards(visible);
        const frag = document.createDocumentFragment();
        visible.forEach(c => frag.appendChild(c));
        hidden.forEach(c => frag.appendChild(c));
        grid.appendChild(frag);
        visible.forEach(c => { c.classList.remove('hidden','opacity-30','pointer-events-none'); if (!reduceMotion) { c.style.animationDelay = '0ms'; }});
        hidden.forEach(c => { c.classList.add('hidden','opacity-30','pointer-events-none'); });
      }
      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          const tag = chip.dataset.chip;
          if (tag === 'all') { active.clear(); active.add('all'); }
          else {
            if (active.has('all')) active.delete('all');
            if (active.has(tag)) active.delete(tag); else active.add(tag);
            if (active.size === 0) active.add('all');
          }
          chips.forEach(c => c.classList.toggle('active', active.has('all') ? c.dataset.chip === 'all' : active.has(c.dataset.chip)));
          render();
        });
      });
      if (search) search.addEventListener('input', render);
      if (sortSel) sortSel.addEventListener('change', render);
      chips.forEach(c => c.classList.toggle('active', c.dataset.chip === 'all'));
      render();

      // ---- Keyboard focus polish ----
      let mouseDown = false;
      document.addEventListener('mousedown', () => { mouseDown = true; });
      document.addEventListener('mouseup',   () => { mouseDown = false; });
      document.addEventListener('focusin', (e) => { if (mouseDown) e.target.classList.add('outline-none'); });
      document.addEventListener('focusout', (e) => { e.target.classList.remove('outline-none'); });
    })();
  </script>

  <!-- ========== Command Palette (Accessible) ========== -->
  <script>
    (() => {
      const palette = document.getElementById('cmdk');
      const backdrop = document.getElementById('cmdk-backdrop');
      const input = document.getElementById('cmdk-input');
      const list = document.getElementById('cmdk-list');

      /* Focus trap support */
      let previouslyFocused = null;
      function getTabbables() {
        return palette.querySelectorAll('input,button,[href],select,textarea,[tabindex]:not([tabindex="-1"])');
      }
      function trapTab(e) {
        if (e.key !== 'Tab') return;
        const nodes = Array.from(getTabbables());
        if (!nodes.length) return;
        const first = nodes[0];
        const last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }

      function openPalette() {
        previouslyFocused = document.activeElement;
        backdrop.classList.remove('pointer-events-none'); palette.classList.remove('pointer-events-none');
        requestAnimationFrame(() => {
          backdrop.classList.add('opacity-100'); palette.classList.add('opacity-100');
        });
        input.value=''; render(''); input.focus();
        document.addEventListener('keydown', trapTab, true);
      }
      function closePalette() {
        backdrop.classList.remove('opacity-100'); palette.classList.remove('opacity-100');
        setTimeout(() => {
          backdrop.classList.add('pointer-events-none'); palette.classList.add('pointer-events-none');
          input.blur();
          document.removeEventListener('keydown', trapTab, true);
          previouslyFocused && previouslyFocused.focus();
        }, 150);
      }

      function indexItems() {
        const items = [];
        document.querySelectorAll('section[id]').forEach(sec => {
          const id = sec.id;
          const title = sec.querySelector('h2')?.textContent?.trim() || id;
          items.push({ label:`Section — ${title}`, url:`#${id}`, type:'section' });
        });
        document.querySelectorAll('header [data-nav]').forEach(a => {
          items.push({ label:`Nav — ${a.textContent.trim()}`, url:a.getAttribute('href'), type:'nav' });
        });
        document.querySelectorAll('.project-card').forEach(card => {
          items.push({
            label: `Project — ${card.dataset.title}`,
            url: '#projects',
            type: 'project',
            el: card,
            tags: (card.dataset.tags || '').split(/\s+/)
          });
        });

        /* Palette actions: theme toggles */
        items.push({ label:'Theme — Toggle Light',  type:'action', action:()=>window.setTheme('light') });
        items.push({ label:'Theme — Toggle Dark',   type:'action', action:()=>window.setTheme('dark') });
        items.push({ label:'Theme — Use System',    type:'action', action:()=>window.setTheme('system') });
        items.push({ label:'Accent — Blue',         type:'action', action:()=>window.setAccent('default') });
        items.push({ label:'Accent — Green',        type:'action', action:()=>window.setAccent('green') });
        items.push({ label:'Accent — Amber',        type:'action', action:()=>window.setAccent('amber') });
        items.push({ label:'Accent — Purple',       type:'action', action:()=>window.setAccent('purple') });

        return items;
      }
      const INDEX = indexItems();

      function norm(s){ return (s||'').toLowerCase().trim(); }
      function score(q, text) {
        const i = text.indexOf(q);
        return i < 0 ? -1 : (q.length ? (100 - i) + Math.min(q.length, text.length) : 1);
      }

      let activeIndex = -1;
      function render(query) {
        const q = norm(query);
        const results = INDEX.map(it => {
          const base = norm(it.label);
          const s = score(q, base) + (it.tags && it.tags.some(t=>norm(t).includes(q)) ? 10 : 0);
          return { it, s };
        }).filter(r => r.s >= 0)
          .sort((a,b)=> b.s - a.s)
          .slice(0, 20);

        list.innerHTML = '';
        results.forEach(({it}, idx) => {
          const li = document.createElement('li');
          li.className = 'p-2 cursor-pointer flex items-center justify-between bg-transparent hover:bg-neutral-100';
          li.setAttribute('role','option');
          li.id = `cmdk-opt-${idx}`;
          li.dataset.index = idx;
          li.innerHTML = `<span class="text-neutral-900">${it.label}</span><span class="text-[11px] text-neutral-500">${it.type}</span>`;
          li.addEventListener('click', () => activate(it));
          list.appendChild(li);
        });
        activeIndex = results.length ? 0 : -1;
        highlight();
      }

      function highlight(){
        const items = list.querySelectorAll('[role="option"]');
        items.forEach((li,i)=>{
          li.classList.toggle('bg-neutral-100', i===activeIndex);
        });
        const active = items[activeIndex];
        input.setAttribute('aria-activedescendant', active ? active.id : '');
        if (active) active.scrollIntoView({ block: 'nearest' });
      }

      function activate(it){
        closePalette();
        if (it.action) return it.action();
        if (it.el) {
          it.el.scrollIntoView({behavior:'smooth', block:'start'});
          it.el.classList.add('ring','ring-accent-300');
          setTimeout(()=>it.el.classList.remove('ring','ring-accent-300'),800);
        }
        if (it.url) location.href = it.url;
      }

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openPalette(); }
        if (e.key === 'Escape' && !palette.classList.contains('pointer-events-none')) closePalette();
        if (!palette.classList.contains('pointer-events-none')) {
          if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(activeIndex + 1, list.children.length - 1); highlight(); }
          if (e.key === 'ArrowUp')   { e.preventDefault(); activeIndex = Math.max(activeIndex - 1, 0); highlight(); }
          if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); list.children[activeIndex]?.click(); }
        }
      });
      backdrop.addEventListener('click', closePalette);
      input.addEventListener('input', e=>render(e.target.value));

      // expose open/close for future bindings if needed
      window.__cmdk = { open: openPalette, close: closePalette };
    })();
  </script>

  <!-- ========== Adaptive Theme Controller (persist + system sync) ========== -->
  <script>
    (function () {
      const root = document.documentElement;
      const THEME_KEY = 'theme-preference';     // 'system' | 'light' | 'dark'
      const ACCENT_KEY = 'accent-preference';   // 'default' | 'green' | 'amber' | 'purple'
      const mm = window.matchMedia('(prefers-color-scheme: dark)');

      function applyTheme(mode) {
        const effective = (mode === 'system') ? (mm.matches ? 'dark' : 'light') : mode;
        root.setAttribute('data-theme', mode);
        root.dataset.themeEffective = effective;
      }
      function applyAccent(name) {
        root.setAttribute('data-accent', name || 'default');
      }

      function setTheme(mode) {
        localStorage.setItem(THEME_KEY, mode);
        applyTheme(mode);
      }
      function setAccent(name) {
        localStorage.setItem(ACCENT_KEY, name || 'default');
        applyAccent(name || 'default');
      }

      // Initialize from storage (or defaults already on <html>)
      const savedTheme  = localStorage.getItem(THEME_KEY)  || root.getAttribute('data-theme')  || 'system';
      const savedAccent = localStorage.getItem(ACCENT_KEY) || root.getAttribute('data-accent') || 'default';
      applyTheme(savedTheme);
      applyAccent(savedAccent);

      // React to system changes when in "system"
      mm.addEventListener?.('change', () => {
        const pref = localStorage.getItem(THEME_KEY) || 'system';
        if (pref === 'system') applyTheme('system');
      });

      // Expose helpers globally (used by palette + header controls)
      window.setTheme = setTheme;
      window.setAccent = setAccent;

      // Header theme menu wiring (with a11y + focus return + simple trap)
      const btn = document.getElementById('theme-menu-button');
      const menu = document.getElementById('theme-menu');

      if (btn && menu) {
        let menuOpen = false;
        let lastFocus = null;

        function getMenuItems(){ return menu.querySelectorAll('[role="menuitem"]'); }
        function open() {
          if (menuOpen) return;
          lastFocus = document.activeElement;
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded','true');
          menuOpen = true;
          menu.focus();
          document.addEventListener('keydown', onKeydown, true);
          document.addEventListener('click', onDocClick, true);
        }
        function close() {
          if (!menuOpen) return;
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded','false');
          menuOpen = false;
          document.removeEventListener('keydown', onKeydown, true);
          document.removeEventListener('click', onDocClick, true);
          (lastFocus || btn).focus();
        }
        function onKeydown(e) {
          if (!menuOpen) return;
          const items = Array.from(getMenuItems());
          const currentIndex = items.indexOf(document.activeElement);
          switch (e.key) {
            case 'Escape': e.stopPropagation(); e.preventDefault(); close(); break;
            case 'ArrowDown':
              e.preventDefault();
              (items[(currentIndex + 1 + items.length) % items.length] || menu).focus();
              break;
            case 'ArrowUp':
              e.preventDefault();
              (items[(currentIndex - 1 + items.length) % items.length] || menu).focus();
              break;
            case 'Tab':
              // simple focus trap within the menu when open
              e.preventDefault();
              if (e.shiftKey) {
                (items[(currentIndex - 1 + items.length) % items.length] || items[0]).focus();
              } else {
                (items[(currentIndex + 1 + items.length) % items.length] || items[0]).focus();
              }
              break;
          }
        }
        function onDocClick(e) {
          if (!menu.contains(e.target) && e.target !== btn) close();
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.contains('hidden') ? open() : close();
        });

        getMenuItems().forEach(el => {
          el.addEventListener('click', () => { // apply and close
            if (el.dataset.setTheme) window.setTheme(el.dataset.setTheme);
            if (el.dataset.setAccent) window.setAccent(el.dataset.setAccent);
            close();
          });
        });
      }
    })();
  </script>
</body>
</html>